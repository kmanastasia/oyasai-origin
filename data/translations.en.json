    { "ref_type": "entry", "ref_id": "e-03", "source_quote": "葉の先が丸まったら、水を止める", "source_reason_quote": null, "text": "When the leaf tips curl, stop the water.", "reason_text": null, "title_text": "The sign to stop watering", "untranslated": [], "reviewed_by": null },
