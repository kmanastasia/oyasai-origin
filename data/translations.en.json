    { "ref_type": "entry", "ref_id": "e-01", "text": "In the morning the fog comes down, and it doesn't clear until noon.", "reason_text": null, "title_text": "Morning fog and clearing skies", "untranslated": [], "reviewed_by": null },
    { "ref_type": "entry", "ref_id": "e-02", "text": "Learned how to save seed from the old woman next door.", "reason_text": null, "title_text": "Who taught seed saving", "untranslated": [], "reviewed_by": null },
    { "ref_type": "entry", "ref_id": "e-03", "text": "When the leaf tips curl, stop the water.", "reason_text": null, "title_text": "The sign to stop watering", "untranslated": [], "reviewed_by": null },
    { "ref_type": "entry", "ref_id": "e-04", "text": "Drop the seeds two fingers apart.", "reason_text": null, "title_text": "Spacing the seeds", "untranslated": [], "reviewed_by": null },
    { "ref_type": "entry", "ref_id": "e-05", "text": "Don't pull them until the frost comes.", "reason_text": "Frost makes them sweet.", "title_text": "What decides the harvest", "untranslated": [], "reviewed_by": null },
    { "ref_type": "entry", "ref_id": "e-06", "text": "Raw, bite into it skin and all.", "reason_text": null, "title_text": "Eating it raw", "untranslated": [], "reviewed_by": null },
