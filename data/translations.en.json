    { "ref_type": "entry", "ref_id": "e-05", "source_quote": "霜が降りるまで抜かん", "source_reason_quote": "霜に当てると、甘かなる", "text": "Don't pull them until the frost comes.", "reason_text": "Frost makes them sweet.", "title_text": "What decides the harvest", "untranslated": [], "reviewed_by": null },
